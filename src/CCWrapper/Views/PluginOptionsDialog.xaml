<Window x:Class="CCWrapper.Views.PluginOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="Sensitive values are never shown: leave one empty to keep what is stored. Claude Code applies the options when a session starts."
                   Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        <StackPanel x:Name="Fields" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button Style="{StaticResource Primary}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
