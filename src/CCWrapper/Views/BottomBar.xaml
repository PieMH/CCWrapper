<UserControl x:Class="CCWrapper.Views.BottomBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Panel}" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource Line}" />
        </Style>
        <Style x:Key="Bar" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
    </UserControl.Resources>
    <DockPanel Height="36" Margin="6,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <StackPanel x:Name="CompactHint" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="CompactText" Foreground="{StaticResource Warn}" />
                <Button x:Name="CompactButton" Style="{StaticResource Chip}" Content="Compact" Margin="6,0,0,0" Click="OnCompact" />
                <Border Style="{StaticResource Sep}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" ToolTip="Context window: tokens used / window size">
                <TextBlock Text="ctx" Style="{StaticResource Dim}" />
                <Border Style="{StaticResource MeterTrack}"><Border x:Name="CtxBar" Style="{StaticResource Bar}" Background="{StaticResource Muted}" /></Border>
                <TextBlock x:Name="CtxText" />
            </StackPanel>
            <Border Style="{StaticResource Sep}" />
            <!-- ClickMode=Press: the click that closes the popup is the same mouse-down the 250 ms guard measures. A Button: it takes Win32 focus off the terminal's WebView2 when clicked, and has an automation peer for screen readers. -->
            <Button x:Name="UsageGroup" Style="{StaticResource Chip}" Padding="6,0" Margin="0" ToolTipOpening="OnUsageTip"
                    AutomationProperties.Name="Plan usage details" ClickMode="Press" GotKeyboardFocus="OnChipFocus" Click="OnUsageClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="5h" Style="{StaticResource Dim}" />
                    <Border Style="{StaticResource MeterTrack}"><Border x:Name="FiveHourBar" Style="{StaticResource Bar}" /></Border>
                    <TextBlock x:Name="FiveHourText" MinWidth="28" />
                    <TextBlock Text="wk" Style="{StaticResource Dim}" Margin="10,0,0,0" />
                    <Border Style="{StaticResource MeterTrack}"><Border x:Name="WeekBar" Style="{StaticResource Bar}" /></Border>
                    <TextBlock x:Name="WeekText" MinWidth="28" />
                </StackPanel>
            </Button>
            <!-- A Popup is its own window, so it may sit over the terminal's WebView2. Not inside UsageGroup: clicks in it would bubble to the toggle.
                 StaysOpen=True: StaysOpen=False's mouse capture closed it only on clicks in other apps, not on clicks elsewhere in this window; the code closes it (OnWindowMouseDown, OnUsageFocusWithin).
                 AllowsTransparency: else the popup window paints black behind the rounded corners. -->
            <Popup x:Name="UsagePopup" PlacementTarget="{Binding ElementName=UsageGroup}" Placement="Top" StaysOpen="True" AllowsTransparency="True" Closed="OnUsageClosed">
                <Border x:Name="UsagePanel" Style="{StaticResource UsagePanel}" Focusable="True" PreviewKeyDown="OnUsageKey" IsKeyboardFocusWithinChanged="OnUsageFocusWithin">
                    <StackPanel x:Name="UsageBody" />
                </Border>
            </Popup>
            <Border Style="{StaticResource Sep}" />
            <TextBlock x:Name="SpendText" Foreground="#AEB7C2" ToolTip="Session tokens in / out, and cost" />
            <Button x:Name="RefreshButton" Style="{StaticResource Chip}" Width="28" Padding="0" Margin="6,0,0,0" Click="OnRefresh">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Foreground="#AEB7C2" />
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ModelButton" Style="{StaticResource Chip}" ClickMode="Press" GotKeyboardFocus="OnChipFocus" Click="OnModel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="model " Style="{StaticResource Dim}" />
                    <TextBlock x:Name="ModelValue" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="6,1,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="EffortButton" Style="{StaticResource Chip}" ClickMode="Press" GotKeyboardFocus="OnChipFocus" Click="OnEffort">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="effort " Style="{StaticResource Dim}" />
                    <TextBlock x:Name="EffortValue" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="6,1,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="ModeButton" Style="{StaticResource Chip}" ClickMode="Press" GotKeyboardFocus="OnChipFocus" Click="OnMode">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="mode " Style="{StaticResource Dim}" />
                    <TextBlock x:Name="ModeValue" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="6,1,0,0" />
                </StackPanel>
            </Button>
            <!-- The model/effort/mode chooser: the usage popup's frame and the same close rules (OnWindowMouseDown, OnChoiceFocusWithin, Esc), see the comment on UsagePopup.
                 ClickMode=Press on the chips, for the same reason as on UsageGroup. The rows are built in code (Open). -->
            <Popup x:Name="ChoicePopup" Placement="Top" StaysOpen="True" AllowsTransparency="True" Closed="OnChoiceClosed">
                <Border x:Name="ChoicePanel" Style="{StaticResource UsagePanel}" Width="260" Padding="6" Focusable="True" PreviewKeyDown="OnChoiceKey" IsKeyboardFocusWithinChanged="OnChoiceFocusWithin">
                    <StackPanel x:Name="ChoiceBody" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                </Border>
            </Popup>
            <Button x:Name="UpdateButton" Style="{StaticResource Chip}" Visibility="Collapsed" Margin="8,0,0,0" Click="OnUpdate"
                    ToolTip="Restart CCWrapper to install it. Otherwise it installs when CCWrapper closes.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                    <TextBlock x:Name="UpdateText" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </DockPanel>
</UserControl>
