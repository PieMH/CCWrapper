<Window x:Class="CCWrapper.Views.NewSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New session" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg}">
    <StackPanel Margin="20">
        <TextBlock Text="Folder" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Padding="12,4" Click="OnBrowse" />
            <ComboBox x:Name="Folder" IsEditable="True" HorizontalAlignment="Stretch" TextBoxBase.TextChanged="OnFolderChanged" />
        </DockPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Model" Margin="0,0,0,4" />
                <ComboBox x:Name="Model" IsEditable="True" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="3,0">
                <TextBlock Text="Effort" Margin="0,0,0,4" />
                <ComboBox x:Name="Effort" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock Text="Permission mode" Margin="0,0,0,4" />
                <ComboBox x:Name="Mode" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Name (optional)" Margin="0,14,0,4" />
        <TextBox x:Name="SessionName" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="Start" IsDefault="True" IsEnabled="False" Click="OnStart" />
        </StackPanel>
    </StackPanel>
</Window>
