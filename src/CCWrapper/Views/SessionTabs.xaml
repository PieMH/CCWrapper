<UserControl x:Class="CCWrapper.Views.SessionTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CCWrapper.Views"
             xmlns:core="clr-namespace:CCWrapper.Core"
             Background="{StaticResource Panel}">
    <UserControl.Resources>
        <!-- One card: hover, and the active one raised with the accent underline. Cards are dragged to reorder. -->
        <Style x:Key="Card" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Width" Value="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=views:SessionTabs}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title, TargetNullValue='New session'}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnCardDown" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnCardRightDown" />
            <EventSetter Event="ContextMenuOpening" Handler="OnCardMenu" />
            <EventSetter Event="PreviewMouseMove" Handler="OnCardMove" />
            <EventSetter Event="DragOver" Handler="OnCardDragOver" />
            <EventSetter Event="Drop" Handler="OnCardDrop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="30" Margin="0,0,2,0" Background="Transparent">
                            <Border x:Name="Bd" CornerRadius="6" Padding="10,0,4,0" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline" Height="2" Margin="8,0" CornerRadius="1" VerticalAlignment="Bottom"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20242A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status: ● working, ◎ waiting for input (pulses unless Windows animations are off), ○ idle, dim ○ ended -->
        <Style x:Key="StatusRing" TargetType="Ellipse">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Busy">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Exited">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Width" Value="13" />
                    <Setter Property="Height" Value="13" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Waiting" />
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="White" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Busy">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Width" Value="8" />
                    <Setter Property="Height" Value="8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Width" Value="5" />
                    <Setter Property="Height" Value="5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCard" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Height="38" Padding="6,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}">
        <DockPanel>
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource Flat}" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                    ToolTip="Search this session (Ctrl+F)" AutomationProperties.Name="Search this session" Click="OnSearch">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" />
            </Button>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnWheel">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ListBox x:Name="Cards" ItemContainerStyle="{StaticResource Card}" SelectionChanged="OnSelect" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Open sessions">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter /> <!-- no inner scroller: the bar's own one scrolls sideways -->
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:LiveSession}">
                                <DockPanel ToolTip="{Binding Title, TargetNullValue='New session'}">
                                    <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusRing}" />
                                        <Ellipse Style="{StaticResource StatusDot}" />
                                    </Grid>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource GitIcon}" Stroke="{StaticResource Muted}" StrokeThickness="1.6" Width="11" Height="11"
                                          Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                          ToolTip="{Binding Worktree, StringFormat='Works in its own git worktree: {0}'}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Worktree}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseCard}" ToolTip="Close this session (it stays resumable)"
                                            AutomationProperties.Name="Close session" Click="OnCloseCard">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" />
                                    </Button>
                                    <TextBlock Text="{Binding Title, TargetNullValue='New session'}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- A session open in another terminal: read-only, until Resume here makes it a live card -->
                    <Grid x:Name="ReadOnlyCard" Height="30" Margin="0,0,2,0" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                          Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=views:SessionTabs}}" MouseLeftButtonUp="OnReadOnlyClick">
                        <Border x:Name="ReadOnlyBg" CornerRadius="6" Padding="10,0,4,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE890;" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCard}" ToolTip="Close the read-only view" AutomationProperties.Name="Close read-only view" Click="OnCloseReadOnly">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" />
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Text="read-only" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock x:Name="ReadOnlyTitle" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="ReadOnlyUnderline" Height="2" Margin="8,0" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>

                    <Button x:Name="NewButton" Style="{StaticResource Flat}" Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                            ToolTip="New session" AutomationProperties.Name="New session" Click="OnNew">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
