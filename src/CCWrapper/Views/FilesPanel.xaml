<UserControl x:Class="CCWrapper.Views.FilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CCWrapper.Views">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
            <TextBox x:Name="SearchBox" Padding="30,6,8,6" TextChanged="OnSearch" AutomationProperties.Name="Search files" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource Muted}" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
            <TextBlock Text="Search files" Margin="31,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Grid>
        <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" KeyDown="OnKeyDown" ContextMenuOpening="OnMenuOpening" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="OpenWithItem" Header="Open with…" Click="OnOpenWith" />
                    <MenuItem x:Name="ExplorerItem" Header="Show in File Explorer" Click="OnExplorer" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnDoubleClick" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:FileNode}" ItemsSource="{Binding Children}">
                    <DockPanel ToolTip="{Binding Tip}">
                        <TextBlock DockPanel.Dock="Right" Width="16" Text="{Binding Badge}" TextAlignment="Center" Foreground="{StaticResource Good}" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Minus}" Foreground="{StaticResource Bad}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Plus}" Foreground="{StaticResource Good}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Other}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Foreground" Value="#AEB7C2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock x:Name="Empty" Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</UserControl>
