<Window x:Class="CCWrapper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CCWrapper.Views"
        Title="Settings" Width="1080" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Editor" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource TerminalBg}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Save bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Save" Padding="18,0" Click="OnSave" />
                <Button x:Name="RevertButton" DockPanel.Dock="Right" Style="{StaticResource Outlined}" Height="32" Content="Revert" Margin="0,0,8,0" Click="OnRevert" />
                <Ellipse x:Name="SaveDot" Width="8" Height="8" Margin="0,0,10,0" Fill="{StaticResource SwitchOff}" VerticalAlignment="Center" />
                <TextBlock x:Name="SaveText" Foreground="{StaticResource TextSoft}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- Left rail -->
        <Border DockPanel.Dock="Left" Width="230" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,14">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0">
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Claude Code applies the most specific file: Local over Project over User. Managed policy beats all three." />
                </Border>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" Padding="30,6,8,6" TextChanged="OnSearch" AutomationProperties.Name="Find a setting" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource Muted}" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Find a setting" Margin="31,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" IsChecked="True">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="16" Margin="0,0,10,0" />
                            <TextBlock Text="General" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPermissions" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Width="16" Margin="0,0,10,0" />
                            <TextBlock x:Name="PermissionsCount" DockPanel.Dock="Right" Style="{StaticResource Dim}" FontWeight="Normal" />
                            <TextBlock Text="Permissions" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHooks" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Width="16" Margin="0,0,10,0" />
                            <TextBlock x:Name="HooksCount" DockPanel.Dock="Right" Style="{StaticResource Dim}" FontWeight="Normal" />
                            <TextBlock Text="Hooks" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavEnv" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" Width="16" Margin="0,0,10,0" />
                            <TextBlock Text="Environment" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMemory" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Width="16" Margin="0,0,10,0" />
                            <TextBlock Text="CLAUDE.md" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJson" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" Width="16" Margin="0,0,10,0" />
                            <TextBlock Text="JSON" />
                        </DockPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Project folder" Style="{StaticResource Dim}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ProjectBox" MinWidth="180" SelectionChanged="OnProjectChanged" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource Dim}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- Which file the page edits -->
                <StackPanel x:Name="ScopeArea">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="4">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="ScopeUser" Style="{StaticResource ScopeCard}" GroupName="Scope" IsChecked="True" Checked="OnScope" Margin="0,0,3,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="User" FontWeight="SemiBold" />
                                        <TextBlock x:Name="UserCount" Style="{StaticResource Dim}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="UserSub" Style="{StaticResource Dim}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ScopeProject" Style="{StaticResource ScopeCard}" GroupName="Scope" Checked="OnScope" Margin="3,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Project" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ProjectCount" Style="{StaticResource Dim}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Shared with the repo · .claude\settings.json" Style="{StaticResource Dim}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ScopeLocal" Style="{StaticResource ScopeCard}" GroupName="Scope" Checked="OnScope" Margin="3,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Local" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LocalCount" Style="{StaticResource Dim}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Just you, this folder · .claude\settings.local.json" Style="{StaticResource Dim}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <WrapPanel Margin="2,8,0,0">
                        <TextBlock x:Name="FilePath" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,12,0" />
                        <TextBlock x:Name="FileState" FontSize="12" Margin="0,0,12,0" />
                        <Button x:Name="ViewJsonLink" Style="{StaticResource Link}" Content="View as JSON" Click="OnViewJson" />
                    </WrapPanel>
                    <Border x:Name="BrokenBanner" Background="{StaticResource NoteFill}" BorderBrush="{StaticResource NoteLine}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock x:Name="BrokenText" Foreground="{StaticResource NoteText}" FontSize="12" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <!-- CLAUDE.md: each tab is its own file -->
                <Border x:Name="MemoryNote" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Each tab is its own file. Saving writes the files you changed, nothing else. Claude reads them when a session starts." />
                    </DockPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <!-- ============ General, Permissions, search results: one row per setting ============ -->
                <ScrollViewer x:Name="FieldsPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="FieldRowsBox" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" CornerRadius="10" ClipToBounds="True">
                            <StackPanel x:Name="FieldRows" />
                        </Border>
                        <TextBlock x:Name="NoMatches" Text="No setting matches. The JSON page has every key of the file." Style="{StaticResource Dim}" FontSize="13" Margin="4,4,0,0" Visibility="Collapsed" />

                        <StackPanel x:Name="RulesPanel" Margin="0,16,0,0">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Add a rule" Style="{StaticResource Dim}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Add" Margin="8,0,0,0" Click="OnAddRule" />
                                <ComboBox x:Name="RuleKind" DockPanel.Dock="Right" MinWidth="100" SelectedIndex="0" Margin="8,0,0,0">
                                    <ComboBoxItem Tag="allow" Content="Allow" />
                                    <ComboBoxItem Tag="ask" Content="Ask" />
                                    <ComboBoxItem Tag="deny" Content="Deny" />
                                </ComboBox>
                                <Grid>
                                    <TextBox x:Name="RuleBox" Style="{StaticResource Field}" TextChanged="OnRuleTyped" />
                                    <TextBlock Text="Bash(npm test:*)" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RuleBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                            <TextBlock x:Name="RuleError" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" />
                            <ItemsControl x:Name="RuleLists">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RuleListView}">
                                        <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Color}" />
                                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Dim}" Visibility="{Binding EmptyVisibility}" />
                                                <ItemsControl ItemsSource="{Binding Rules}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:RuleChip}">
                                                            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" CornerRadius="6" Padding="10,0,2,0" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                                                                    <Button Style="{StaticResource Flat}" MinHeight="26" Width="26" Padding="0" Margin="4,0,0,0" Foreground="{StaticResource Muted}"
                                                                            ToolTip="Remove" AutomationProperties.Name="{Binding RemoveLabel}" Click="OnRemoveRule">
                                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Hooks ============ -->
                <ScrollViewer x:Name="HooksPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border x:Name="NoHooks" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                            <TextBlock x:Name="NoHooksText" Foreground="{StaticResource TextSoft}" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl x:Name="HookList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HookRowView}">
                                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,0,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Style="{StaticResource Small}" Content="Edit…" IsEnabled="{Binding CanEdit}" ToolTip="{Binding EditTip}" Click="OnEditHook" />
                                                <Button Style="{StaticResource SmallDanger}" Content="Remove" Margin="8,0,0,0" Click="OnRemoveHook" />
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="{StaticResource Raised}" CornerRadius="6" Padding="8,2">
                                                        <TextBlock Text="{Binding Row.Event}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding MatcherText}" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TimeoutText}" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Background="{StaticResource TerminalBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                    <TextBlock Text="{Binding CommandText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoft}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CommandText}" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddHookButton" Style="{StaticResource Outlined}" Height="32" Content="Add hook…" Click="OnAddHook" />
                            <TextBlock Text="Plugins add their own hooks: Plugins &amp; connectors lists them." Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Environment ============ -->
                <ScrollViewer x:Name="EnvPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>
                                <Grid Background="{StaticResource Panel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Variable" Style="{StaticResource Label}" Margin="14,8" />
                                    <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource Label}" Margin="8,8" />
                                </Grid>
                                <ItemsControl x:Name="EnvList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:EnvRowView}">
                                            <Grid Margin="14,6,6,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource Field}" Text="{Binding Name, Mode=OneTime}" Tag="Name" TextChanged="OnEnvTyped" AutomationProperties.Name="Variable name" />
                                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBox x:Name="ValueBox" Text="{Binding Value, Mode=OneTime}" Tag="Value" TextChanged="OnEnvTyped" AutomationProperties.Name="Value">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Secret}" Value="True" />
                                                                            <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="Transparent" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBlock Text="••••••••" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Secret}" Value="True" />
                                                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=ValueBox}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Grid.Column="2" Style="{StaticResource Flat}" Width="30" Padding="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"
                                                        ToolTip="Remove" AutomationProperties.Name="Remove variable" Click="OnRemoveEnv">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="EnvError" Foreground="{StaticResource Bad}" FontSize="12" Margin="2,8,0,0" Visibility="Collapsed" />
                        <DockPanel Margin="0,10,0,0">
                            <Button x:Name="AddEnvButton" Style="{StaticResource Outlined}" Height="32" Content="Add variable" Click="OnAddEnv" />
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Values whose names look like keys or tokens stay hidden until you click into them. The Project file is shared with the repo: keep secrets in Local." />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ CLAUDE.md ============ -->
                <DockPanel x:Name="MemoryPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MemUser" Style="{StaticResource Segment}" GroupName="Memory" Content="User · CLAUDE.md" Checked="OnMemoryTab" />
                                <RadioButton x:Name="MemProject" Style="{StaticResource Segment}" GroupName="Memory" Content="Project · CLAUDE.md" Checked="OnMemoryTab" />
                                <RadioButton x:Name="MemLocal" Style="{StaticResource Segment}" GroupName="Memory" Content="Project · CLAUDE.local.md" Checked="OnMemoryTab" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="2,8,0,0">
                            <TextBlock x:Name="MemoryPath" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,12,0" />
                            <TextBlock x:Name="MemoryState" Style="{StaticResource Dim}" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBox x:Name="MemoryBox" Style="{StaticResource Editor}" TextChanged="OnMemoryTyped" AutomationProperties.Name="CLAUDE.md text" />
                </DockPanel>

                <!-- ============ JSON ============ -->
                <DockPanel x:Name="JsonPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="JsonIcon" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock x:Name="JsonState" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Keys this window does not show are kept as they are." Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="JsonBox" Style="{StaticResource Editor}" TextChanged="OnJsonTyped" AutomationProperties.Name="Settings file as JSON" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
