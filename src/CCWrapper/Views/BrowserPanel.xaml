<UserControl x:Class="CCWrapper.Views.BrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="←" Width="30" Padding="0" ToolTip="Back" Click="OnBack" IsEnabled="{Binding CanGoBack, ElementName=Web}" />
            <Button Grid.Column="1" Content="→" Width="30" Padding="0" Margin="4,0,0,0" ToolTip="Forward" Click="OnForward" IsEnabled="{Binding CanGoForward, ElementName=Web}" />
            <Button Grid.Column="2" Content="↻" Width="30" Padding="0" Margin="4,0,4,0" ToolTip="Reload" Click="OnReload" />
            <TextBox x:Name="Address" Grid.Column="3" KeyDown="OnAddressKeyDown" GotKeyboardFocus="OnAddressFocus" />
        </Grid>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</UserControl>
