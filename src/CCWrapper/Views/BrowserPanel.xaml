<UserControl x:Class="CCWrapper.Views.BrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,4,8,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Width="28" Padding="0" Margin="4,0,0,0" ToolTip="New tab" AutomationProperties.Name="New tab" Click="OnNewTab"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" /></Button>
            <!-- one row of equal tabs that shrink as more open -->
            <UniformGrid x:Name="Strip" Rows="1" HorizontalAlignment="Left" />
        </DockPanel>
        <!-- DataContext: the front tab's WebView2 -->
        <Grid x:Name="Bar" DockPanel.Dock="Top" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Flat}" Width="30" Padding="0" ToolTip="Back" AutomationProperties.Name="Back" Click="OnBack" IsEnabled="{Binding CanGoBack, FallbackValue=False}"><TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13" /></Button>
            <Button Grid.Column="1" Style="{StaticResource Flat}" Width="30" Padding="0" Margin="2,0,0,0" ToolTip="Forward" AutomationProperties.Name="Forward" Click="OnForward" IsEnabled="{Binding CanGoForward, FallbackValue=False}"><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" /></Button>
            <Button Grid.Column="2" Style="{StaticResource Flat}" Width="30" Padding="0" Margin="2,0,6,0" ToolTip="Reload" AutomationProperties.Name="Reload" Click="OnReload"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" /></Button>
            <TextBox x:Name="Address" Grid.Column="3" KeyDown="OnAddressKeyDown" GotKeyboardFocus="OnAddressFocus" />
        </Grid>
        <!-- each tab's WebView2; only the front one is visible -->
        <Grid x:Name="Pages" />
    </DockPanel>
</UserControl>
