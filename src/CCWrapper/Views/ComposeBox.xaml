<UserControl x:Class="CCWrapper.Views.ComposeBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CCWrapper.Views">
    <Grid Margin="12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Notice" Grid.ColumnSpan="3" Margin="2,0,0,6" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Visibility="Collapsed" />
        <Button x:Name="PlusButton" Grid.Row="1" Style="{StaticResource Flat}" Width="34" Height="34" Padding="0" Margin="0,0,8,3" VerticalAlignment="Bottom"
                ToolTip="Add files or folders, slash commands" AutomationProperties.Name="Add" Click="OnPlus">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15" />
            <Button.ContextMenu>
                <ContextMenu Placement="Top">
                    <MenuItem Header="Add files…" Click="OnAddFiles" />
                    <MenuItem Header="Add folder…" Click="OnAddFolder" />
                    <MenuItem Header="Slash commands" Click="OnSlashMenu" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Grid Grid.Row="1" Grid.Column="1">
            <TextBox x:Name="Input" MinHeight="40" MaxHeight="180" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" AllowDrop="True"
                     PreviewKeyDown="OnKeyDown" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
                     TextChanged="OnTextChanged" SelectionChanged="OnCaretMoved" GotKeyboardFocus="OnHintChanged" LostKeyboardFocus="OnLostFocus"
                     ScrollViewer.ScrollChanged="OnInputScrolled" />
            <!-- Known slash commands in blue over the box's own text, and the ghost of an argument hint at the caret -->
            <local:SlashOverlay x:Name="Overlay" IsHitTestVisible="False" />
            <!-- The default hint with a blinking caret, or the prompt Claude Code suggests (Tab takes it, Enter sends it) -->
            <TextBlock Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                <Run x:Name="HintText" /><Run x:Name="HintCaret" Text="|" />
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- A Popup is its own window, so it may sit over the terminal's WebView2. AllowsTransparency: else it paints black behind the rounded corners. -->
            <Popup x:Name="SlashPopup" PlacementTarget="{Binding ElementName=Input}" Placement="Top" StaysOpen="True" AllowsTransparency="True">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" CornerRadius="8"
                        Width="{Binding ActualWidth, ElementName=Input}" Margin="0,0,0,4">
                    <ListBox x:Name="SlashList" MaxHeight="280" Focusable="False" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnSlashClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource SlashText}" Text="{Binding Name, StringFormat=/{0}}" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
        <Button x:Name="SendButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource Send}" Margin="8,0,0,3" VerticalAlignment="Bottom"
                ToolTip="Send (Enter). Shift+Enter adds a line" AutomationProperties.Name="Send" Click="OnSend">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="15" />
        </Button>
    </Grid>
</UserControl>
