<UserControl x:Class="CCWrapper.Views.ComposeBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Notice" Grid.ColumnSpan="2" Margin="2,0,0,6" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Visibility="Collapsed" />
        <Grid Grid.Row="1">
            <TextBox x:Name="Input" MinHeight="40" MaxHeight="180" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" AllowDrop="True"
                     PreviewKeyDown="OnKeyDown" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
                     TextChanged="OnHintChanged" GotKeyboardFocus="OnHintChanged" LostKeyboardFocus="OnHintChanged" />
            <!-- The default hint with a blinking caret, or the prompt Claude Code suggests (Tab takes it, Enter sends it) -->
            <TextBlock Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                <Run x:Name="HintText" /><Run x:Name="HintCaret" Text="|" />
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Button x:Name="SendButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource Send}" Margin="8,0,0,3" VerticalAlignment="Bottom"
                ToolTip="Send (Enter). Shift+Enter adds a line" AutomationProperties.Name="Send" Click="OnSend">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="15" />
        </Button>
    </Grid>
</UserControl>
