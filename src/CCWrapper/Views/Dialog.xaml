<Window x:Class="CCWrapper.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" PreviewKeyDown="OnKeyDown">
    <StackPanel Margin="20">
        <DockPanel>
            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="22" VerticalAlignment="Top" Margin="0,0,14,0" />
            <TextBlock x:Name="Message" Foreground="{StaticResource Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed" />
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
