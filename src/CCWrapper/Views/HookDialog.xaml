<Window x:Class="CCWrapper.Views.HookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <StackPanel Margin="20">
        <TextBlock Text="Event" Margin="0,0,0,4" />
        <ComboBox x:Name="EventBox" IsEditable="True" AutomationProperties.Name="Event" />
        <TextBlock Text="Matcher" Margin="0,14,0,4" />
        <TextBox x:Name="MatcherBox" AutomationProperties.Name="Matcher" />
        <TextBlock Text="For tool events: a tool name or pattern, like Bash or Edit|Write. Empty matches every tool."
                   Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
        <TextBlock Text="Command" Margin="0,14,0,4" />
        <TextBox x:Name="CommandBox" FontFamily="{StaticResource MonoFont}" FontSize="13" AutomationProperties.Name="Command" />
        <TextBlock Text="Timeout in seconds (optional)" Margin="0,14,0,4" />
        <TextBox x:Name="TimeoutBox" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Timeout in seconds" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button Style="{StaticResource Primary}" Content="OK" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
