<UserControl x:Class="CCWrapper.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CCWrapper.Views">
    <Grid Margin="8,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBox x:Name="Search" Padding="30,6,8,6" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey"
                     ToolTip="Filters titles and projects as you type. Enter searches the full text of every transcript; Esc clears." />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource Muted}" Margin="10,0,0,0"
                       HorizontalAlignment="Left" IsHitTestVisible="False" />
            <TextBlock Text="Search sessions" Foreground="{StaticResource Muted}" IsHitTestVisible="False" Margin="31,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="SearchStatus" Grid.Row="1" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,4,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Style="{StaticResource Nav}" Click="OnNewSession">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{StaticResource Accent}" Width="16" Margin="0,0,10,0" />
                    <TextBlock Text="New session" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource Nav}" Click="OnSettings">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="16" Margin="0,0,10,0" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </DockPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsMenu" Placement="Right" Opened="OnSettingsOpened">
                        <MenuItem Header="Open settings.json" Tag="Settings" Click="OnOpenFile" />
                        <MenuItem Header="Open user CLAUDE.md" Tag="ClaudeMd" Click="OnOpenFile" />
                        <MenuItem Header="Open config folder" Tag="Root" Click="OnOpenFile" />
                        <Separator />
                        <MenuItem Header="Run /config" Tag="/config" Click="OnSlash" />
                        <MenuItem Header="Run /permissions" Tag="/permissions" Click="OnSlash" />
                        <MenuItem Header="Run /hooks" Tag="/hooks" Click="OnSlash" />
                        <MenuItem Header="Run /memory" Tag="/memory" Click="OnSlash" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Style="{StaticResource Nav}" Click="OnCustomize">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Width="16" Margin="0,0,10,0" />
                    <TextBlock Text="Customize" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="3" Height="1" Background="{StaticResource Line}" Margin="4,8" />
        <TextBlock Grid.Row="4" Text="Sessions" Style="{StaticResource Label}" Margin="10,0,0,6" />

        <ListBox x:Name="List" Grid.Row="5" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" KeyDown="OnListKey">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Tag" Value="Active" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:SessionRow}">
                    <Grid ToolTip="{Binding Tip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <!-- the session's /color -->
                                            <DataTrigger Binding="{Binding Color}" Value="red">
                                                <Setter Property="Foreground" Value="{StaticResource SessionRed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="blue">
                                                <Setter Property="Foreground" Value="{StaticResource SessionBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="green">
                                                <Setter Property="Foreground" Value="{StaticResource SessionGreen}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="yellow">
                                                <Setter Property="Foreground" Value="{StaticResource SessionYellow}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="purple">
                                                <Setter Property="Foreground" Value="{StaticResource SessionPurple}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="orange">
                                                <Setter Property="Foreground" Value="{StaticResource SessionOrange}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="pink">
                                                <Setter Property="Foreground" Value="{StaticResource SessionPink}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="cyan">
                                                <Setter Property="Foreground" Value="{StaticResource SessionCyan}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Snippet}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Border CornerRadius="4" Padding="6,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#262B33" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Badge}" Value="working">
                                                <Setter Property="Background" Value="#20352B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Badge}" Value="needs you">
                                                <Setter Property="Background" Value="#3A3122" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Badge}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#AEB7C2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value="working">
                                                    <Setter Property="Foreground" Value="#8FDCAF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="needs you">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Button Width="22" Height="22" MinHeight="0" Padding="0" Margin="4,0,0,0" ToolTip="Close this session (it stays resumable)" Click="OnCloseClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Flat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Grid.Row="5" Margin="0,16,0,0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Grid>
</UserControl>
