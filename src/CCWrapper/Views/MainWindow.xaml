<Window x:Class="CCWrapper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CCWrapper.Views"
        xmlns:terminal="clr-namespace:CCWrapper.Terminal"
        Title="CCWrapper" Width="1400" Height="900">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <DockPanel>
        <!-- Top bar: app name, account + Switch, GitHub label -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CCWrapper" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="Badge" Width="22" Height="22" CornerRadius="11" Margin="16,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText" Foreground="#1E1E1E" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AccountLabel" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Button x:Name="SwitchButton" Content="⇄ Switch" Padding="10,2" Click="OnSwitch" />
                <TextBlock x:Name="GitHubLabel" Text="GitHub: none" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
            <views:BottomBar />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <views:Sidebar Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <terminal:TerminalHost x:Name="TerminalView" />
                <!-- No session open: the terminal is collapsed (WPF cannot draw over WebView2), this takes its cell. -->
                <Border x:Name="EmptyState" Background="#1E1E1E">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No session open" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Start a new session, or pick one from the list to resume it." Opacity="0.6" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <Button Content="＋ New session" Padding="18,6" Margin="0,16,0,0" HorizontalAlignment="Center" Click="OnNewSession" />
                    </StackPanel>
                </Border>
                <!-- A session open in another claude process: its live transcript, read-only, in the terminal's cell. -->
                <DockPanel x:Name="ElsewhereState" Background="#1E1E1E" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Padding="10,8" Background="#2A2A2A" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Continue here as a copy" Padding="10,2" Margin="8,0,0,0" Click="OnContinueAsCopy"
                                    ToolTip="Opens a copy of the conversation under a new id; the original stays as it is" />
                            <Button DockPanel.Dock="Right" Content="Resume here" Padding="10,2" Click="OnResumeHere"
                                    ToolTip="Works once the session is closed in the other terminal" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run x:Name="ElsewhereTitle" FontWeight="SemiBold" />
                                <Run Text="  is open in another terminal: read-only, updates live." Foreground="#E0A030" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <ContentControl x:Name="ElsewhereView" />
                </DockPanel>
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
                    <views:ComposeBox />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />
            <TabControl x:Name="RightTabs" Grid.Column="4">
                <TabItem Header="Files"><views:FilesPanel /></TabItem>
                <TabItem Header="Agents"><views:AgentsPanel /></TabItem>
                <TabItem x:Name="BrowserTab" Header="Browser"><views:BrowserPanel x:Name="Browser" /></TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
