<Window x:Class="CCWrapper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CCWrapper.Views"
        xmlns:terminal="clr-namespace:CCWrapper.Terminal"
        Title="CCWrapper" Width="1400" Height="900" Background="{StaticResource Bg}">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <DockPanel>
        <!-- Top bar: logo, account + Switch, git -->
        <Border DockPanel.Dock="Top" Height="42" Padding="12,0" Background="{StaticResource Panel}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}">
            <DockPanel>
                <Border x:Name="GitChip" DockPanel.Dock="Right" Height="26" Padding="10,0" CornerRadius="6" Background="{StaticResource Raised}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GitIcon}" Stroke="{StaticResource Muted}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="GitAccount" Text="git: none" Foreground="{StaticResource TextDim}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="GitBranchSep" Text="·" Foreground="#4A525D" Margin="6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="GitBranch" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="GitAhead" Foreground="{StaticResource Accent}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="GitBehind" Foreground="{StaticResource Warn}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="WorktreeBox" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Background="Transparent">
                    <TextBlock Text="Worktree" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                    <ToggleButton x:Name="WorktreeSwitch" Style="{StaticResource Switch}" Margin="4,0,0,0" AutomationProperties.Name="Start new sessions in a git worktree" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="CCWrapper" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="/" Foreground="#4A525D" Margin="10,0" VerticalAlignment="Center" />
                    <Border x:Name="Badge" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" Foreground="#1E1E1E" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AccountLabel" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlanLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="SwitchButton" Style="{StaticResource Outlined}" Margin="12,0,0,0" Click="OnSwitch"
                            ToolTip="Restart this window as another account">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Switch account" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}">
            <views:BottomBar x:Name="Bar" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" MinWidth="160" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <views:Sidebar />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <views:SessionTabs x:Name="Tabs" />
                <terminal:TerminalHost x:Name="TerminalView" Grid.Row="1" />
                <!-- No session open: the terminal is collapsed (WPF cannot draw over WebView2), this takes its cell. -->
                <Border x:Name="EmptyState" Grid.Row="1" Background="{StaticResource TerminalBg}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/logo.png" Width="56" Height="56" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14" />
                        <TextBlock Text="No session open" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Start a new session, or pick one from the list to resume it." Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource Primary}" Margin="0,18,0,0" HorizontalAlignment="Center" Click="OnNewSession">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="New session" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- A session open in another claude process: its live transcript, read-only, in the terminal's cell. -->
                <DockPanel x:Name="ElsewhereState" Grid.Row="1" Background="{StaticResource TerminalBg}" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Padding="12,8" Background="{StaticResource Panel}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}">
                        <DockPanel>
                            <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource Outlined}" Content="Continue here as a copy" Margin="8,0,0,0" Click="OnContinueAsCopy"
                                    ToolTip="Opens a copy of the conversation under a new id; the original stays as it is" />
                            <Button x:Name="ResumeButton" DockPanel.Dock="Right" Style="{StaticResource Outlined}" Click="OnResumeHere"
                                    ToolTip="Resumes it here; if it is still open elsewhere, offers to close it there first">
                                <!-- While it works: a gradient sweeps along the bottom edge (see SetResumeBusy) -->
                                <Grid Margin="-10,0" Height="24" ClipToBounds="True">
                                    <TextBlock x:Name="ResumeLabel" Text="Resume here" Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle x:Name="ResumeSweepBar" Width="56" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#004A9BE8" Offset="0" />
                                                <GradientStop Color="#FF4A9BE8" Offset="0.5" />
                                                <GradientStop Color="#004A9BE8" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="ResumeSweep" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Button>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run x:Name="ElsewhereTitle" FontWeight="SemiBold" />
                                <Run x:Name="ElsewhereWhere" Foreground="{StaticResource Warn}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <ContentControl x:Name="ElsewhereView" />
                </DockPanel>
                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}">
                    <views:ComposeBox x:Name="Compose" />
                </Border>
            </Grid>

            <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <TabControl x:Name="RightTabs" Style="{StaticResource UnderlineTabs}">
                    <TabItem Header="Files"><views:FilesPanel /></TabItem>
                    <TabItem Header="Agents"><views:AgentsPanel /></TabItem>
                    <TabItem x:Name="BrowserTab" Header="Browser"><views:BrowserPanel x:Name="Browser" /></TabItem>
                </TabControl>
            </Border>

            <!-- Splitters sit on the panels' inner edges, never over the terminal (WebView2 would cover them) -->
            <GridSplitter Grid.Column="0" Width="4" HorizontalAlignment="Right" Background="Transparent" ResizeBehavior="CurrentAndNext" />
            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndCurrent" />
        </Grid>
    </DockPanel>
</Window>
