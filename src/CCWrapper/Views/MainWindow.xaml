<Window x:Class="CCWrapper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CCWrapper.Views"
        xmlns:terminal="clr-namespace:CCWrapper.Terminal"
        Title="CCWrapper" Width="1400" Height="900">
    <DockPanel>
        <!-- Top bar: app name, account + Switch, GitHub label (T5) -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CCWrapper" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="AccountLabel" Margin="16,0,8,0" VerticalAlignment="Center" />
                <Button x:Name="SwitchButton" Content="Switch" />
                <TextBlock x:Name="GitHubLabel" Text="GitHub: —" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
            <views:BottomBar />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <views:Sidebar Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <terminal:TerminalHost x:Name="TerminalView" />
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
                    <views:ComposeBox />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />
            <TabControl x:Name="RightTabs" Grid.Column="4">
                <TabItem Header="Files"><views:FilesPanel /></TabItem>
                <TabItem Header="Agents"><views:AgentsPanel /></TabItem>
                <TabItem x:Name="BrowserTab" Header="Browser"><views:BrowserPanel x:Name="Browser" /></TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
