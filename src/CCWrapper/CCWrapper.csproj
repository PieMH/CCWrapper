<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <PackageReference Include="DiffPlex.Wpf" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Terminal\wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="CCWrapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencing the relay exe copies CCWrapper.StatusRelay.exe (+ runtimeconfig) next to CCWrapper.exe. -->
    <ProjectReference Include="..\CCWrapper.StatusRelay\CCWrapper.StatusRelay.csproj" />
  </ItemGroup>

</Project>
