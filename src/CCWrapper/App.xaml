<Application x:Class="CCWrapper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Fluent's own brushes in the theme's colors. Kept here, not in a merged dictionary, so they win over Fluent's;
                 its control templates read them dynamically, so text boxes, menus and lists follow. -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#15171B" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#15171B" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1B1E23" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1B1E23" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2A2F37" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#242830" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2A2F37" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#1F2329" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#15171B" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#343A44" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#3D4450" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2A2F37" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#242830" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1F2329" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4E8EE" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#AEB7C2" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A94A1" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2B74C2" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3381D2" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2566AD" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#5AA6EE" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <Color x:Key="SystemAccentColor">#2B74C2</Color>
            <Color x:Key="SystemAccentColorLight1">#3381D2</Color>
            <Color x:Key="SystemAccentColorLight2">#4A9BE8</Color>
            <Color x:Key="SystemAccentColorLight3">#7DB8F0</Color>
            <Color x:Key="SystemAccentColorDark1">#2566AD</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
